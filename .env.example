# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# Project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (Dashboard labels it "anon" or "publishable")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# service_role key — server-only; never expose to the browser
SUPABASE_ADMIN_KEY=

# Clerk (admin auth) — from the Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

CLERK_SECRET_KEY=

# From the Clerk dashboard → Webhooks, once the /api/webhooks/clerk endpoint is configured there
CLERK_WEBHOOK_SECRET=
